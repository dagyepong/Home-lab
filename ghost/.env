# Mail
MAIL_TRANSPORT=SMTP
MAIL_USER=postmaster@mail.example.com
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAILGUN_SMTP_PASSWORD
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_SECURE_CONNECTION=false

# Ghost database
DB_NAME=ghostdb
DB_USER=ghostdbbuser
DB_USER_PASS=REPLACE_WITH_A_NEW_STRONG_DATABASE_PASSWORD
DB_ROOT_PASS=REPLACE_WITH_A_NEW_STRONG_ROOT_PASSWORD

# Persistent data location
DOCKER_VOLUME_STORAGE=./backup

# Backup schedule and retention
BACKUP_INIT_SLEEP=30m
BACKUP_INTERVAL=24h
MYSQL_BACKUP_PRUNE_DAYS=7
DATA_BACKUP_PRUNE_DAYS=7
